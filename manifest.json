{
  "manifest_version": 3,
  "name": "YT Resume",
  "version": "0.1.0",
  "description": "Privately saves and restores YouTube playback positions in this Firefox profile.",
  "icons": {
    "16": "icons/icon-flat-16.png",
    "32": "icons/icon-flat-32.png",
    "48": "icons/icon-flat-48.png",
    "96": "icons/icon-flat-96.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "logic.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "YT Resume",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-flat-16.png",
      "32": "icons/icon-flat-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "logic.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "incognito": "not_allowed",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-resume@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
