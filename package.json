{
  "name": "yt-resume",
  "version": "0.2.8",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "A local-first Firefox and Chromium extension that resumes standard YouTube videos.",
  "scripts": {
    "test": "node --test",
    "lint": "npm run lint:firefox",
    "lint:firefox": "web-ext lint --source-dir firefox",
    "start": "npm run start:firefox",
    "start:firefox": "web-ext run --source-dir firefox --target firefox-desktop",
    "start:chromium": "web-ext run --source-dir chromium --target chromium",
    "build": "npm run build:firefox && npm run build:chromium",
    "build:firefox": "web-ext build --source-dir firefox --artifacts-dir web-ext-artifacts/firefox --overwrite-dest",
    "build:chromium": "web-ext build --source-dir chromium --artifacts-dir web-ext-artifacts/chromium --overwrite-dest"
  },
  "devDependencies": {
    "web-ext": "10.6.0"
  }
}
